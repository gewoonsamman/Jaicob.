      "id": "http_applications",
      "name": "Fetch All Applications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "const clients = ($('Fetch All Clients').first().json.data || []);\nconst vacancies = ($('Fetch All Vacancies').first().json.data || []);\nconst applications = ($('Fetch All Applications').first().json.data || []);\n\nconst weekAgo = new Date();\nweekAgo.setDate(weekAgo.getDate() - 7);\n\nconst results = [];\nfor (const client of clients) {\n  const clientId = client.id;\n  const clientVacancies = vacancies.filter(v => v.clientId === clientId);\n  const vacancyTitles = clientVacancies.map(v => v.title || '').join(', ');\n  const clientApps = applications.filter(a => a.clientId === clientId);\n  const newApps = clientApps.filter(a => {\n    try { return new Date(a.createdAt) >= weekAgo; } catch(e) { return false; }\n  });\n\n  results.push({\n    json: {\n      client_id: clientId,\n      client_name: client.companyName || 'Onbekend',\n      active_vacancies: clientVacancies.length,\n      vacancy_titles: vacancyTitles || 'geen',\n      total_applications: clientApps.length,\n      new_applications: newApps.length,\n      prompt: `Je bent de account manager bij Top Match. Schrijf een kort weekrapport (3-5 zinnen, professioneel Nederlands) voor de klant.\\n\\nKlant: ${client.companyName}\\nActieve vacatures: ${clientVacancies.length}\\nVacature-titels: ${vacancyTitles || 'geen'}\\nNieuwe sollicitaties deze week: ${newApps.length}\\nTotaal sollicitaties: ${clientApps.length}\\n\\nAls er weinig activiteit is, stel dan proactief een actie voor.\\n\\nAntwoord als JSON:\\n{\\n  \"summary\": \"het rapport\",\\n  \"status\": \"on_track|needs_attention|urgent\",\\n  \"suggested_actions\": [\"actie 1\", \"actie 2\"]\\n}`\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{json: {error: 'Geen klanten gevonden'}}];"
      },
      "id": "code_per_client",
      "name": "Build Per-Client Summaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        400
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.prompt }}"
            }
          ]
        },
        "simplify": false,
        "options": {
          "maxTokens": 512
        }
      },
      "id": "http_claude",
      "name": "Claude Writes Reports",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1024,
        400
      ],
      "credentials": {
        "anthropicApi": {
          "id": "j66CYf8R1C5jtddV",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst clientItems = $('Build Per-Client Summaries').all();\nconst statusIcons = { on_track: '🟢', needs_attention: '🟡', urgent: '🔴' };\n\nconst now = new Date();\nlet digest = `📊 *Top Match — Wekelijks Klantenoverzicht*\\n📅 ${now.toLocaleDateString('nl-NL')}\\n${'='.repeat(40)}\\n\\n`;\n\nconst reports = [];\nfor (let i = 0; i < items.length; i++) {\n  const client = clientItems[i]?.json || {};\n  let report;\n  try {\n    const text = items[i].json.content?.[0]?.text || '{}';\n    report = JSON.parse(text);\n  } catch (e) {\n    report = { summary: items[i].json.content?.[0]?.text || 'Geen rapport', status: 'on_track', suggested_actions: [] };\n  }\n\n  const icon = statusIcons[report.status] || '⚪';\n  digest += `${icon} *${client.client_name}*\\n`;\n  digest += `   ${report.summary}\\n`;\n  if (report.suggested_actions && report.suggested_actions.length > 0) {\n    digest += `   Acties:\\n`;\n    for (const action of report.suggested_actions) {\n      digest += `   • ${action}\\n`;\n    }\n  }\n  digest += '\\n';\n\n  reports.push({\n    client_id: client.client_id,\n    client_name: client.client_name,\n    ...report\n  });\n}\n\nreturn [{json: {digest, reports, generated_at: now.toISOString()}}];"
      },
      "id": "code_digest",
      "name": "Build Weekly Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
