{
  "name": "Top Match — CV Parsing Pipeline",
  "nodes": [
    {
      "id": "webhook_1",
      "name": "CV Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "topmatch-cv-upload",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "http_parse",
      "name": "Parse CV via Jaicob",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.jaicob.ai/file/resume",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.JAICOB_API_KEY }}"
            },
            {
              "name": "x-language",
              "value": "nl"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "resume",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "resume"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "http_vacancies",
      "name": "Fetch Active Vacancies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.jaicob.ai/vacancies/public",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.JAICOB_API_KEY }}"
            },
            {
              "name": "x-language",
              "value": "nl"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "take",
              "value": "100"
            },
            {
              "name": "page",
              "value": "1"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code_score",
      "name": "Build Scoring Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const parsedCV = $('Parse CV via Jaicob').first().json;\nconst vacancies = $('Fetch Active Vacancies').first().json.data || [];\nconst candidateJson = JSON.stringify(parsedCV, null, 2);\n\nconst results = [];\nfor (const vacancy of vacancies.slice(0, 10)) {\n  results.push({\n    json: {\n      candidate: parsedCV,\n      vacancy_id: vacancy.id,\n      vacancy_title: vacancy.title || '',\n      prompt: `Je bent een senior recruiter bij Top Match, een recruitmentbureau in Nederland.\\n\\nHieronder staat het geparseerde CV van een kandidaat en de beschrijving van een vacature.\\n\\n**Kandidaat (JSON):**\\n${candidateJson.substring(0, 3000)}\\n\\n**Vacature:**\\nTitel: ${vacancy.title}\\nBeschrijving: ${(vacancy.description || '').substring(0, 1000)}\\n\\nGeef een JSON-antwoord met exact deze velden:\\n- \"score\": een getal van 0.0 tot 1.0 dat aangeeft hoe goed de kandidaat past\\n- \"reasoning\": een korte uitleg in het Nederlands (max 3 zinnen)\\n- \"missing\": een lijst van vaardigheden/eisen die de kandidaat mist\\n\\nAntwoord ALLEEN met geldige JSON, geen tekst eromheen.`\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { error: 'Geen vacatures gevonden' } }];"
      }
    },
    {
      "id": "http_claude",
      "name": "Claude AI Scoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 512,\n  \"messages\": [{\"role\": \"user\", \"content\": {{ JSON.stringify($json.prompt) }}}]\n}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 3,
              "batchInterval": 1000
            }
          }
        }
      }
    },
    {
      "id": "code_filter",
      "name": "Filter Top Matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst pairItems = $('Build Scoring Prompts').all();\nconst MIN_SCORE = 0.6;\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  try {\n    const responseText = items[i].json.content?.[0]?.text || '{}';\n    const scoreData = JSON.parse(responseText);\n    const pair = pairItems[i]?.json || {};\n\n    if (scoreData.score >= MIN_SCORE) {\n      results.push({\n        json: {\n          score: Math.round(scoreData.score * 100),\n          reasoning: scoreData.reasoning,\n          missing: scoreData.missing,\n          vacancy_title: pair.vacancy_title,\n          vacancy_id: pair.vacancy_id,\n          candidate: pair.candidate\n        }\n      });\n    }\n  } catch (e) { /* skip */ }\n}\n\nresults.sort((a, b) => b.json.score - a.json.score);\nreturn results.length > 0 ? results : [{json: {message: 'Geen matches gevonden boven drempel', score: 0}}];"
      }
    },
    {
      "id": "if_match",
      "name": "Match Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1750,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "score_check",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.score }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "http_create_candidate",
      "name": "Create Candidate in Jaicob",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.jaicob.ai/candidates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.JAICOB_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.candidate) }}",
        "options": {}
      }
    },
    {
      "id": "slack_notify",
      "name": "SMS Recruiter via GoHighLevel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/conversations/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GHL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"SMS\",\n  \"contactId\": \"{{ $env.GHL_CONTACT_ID }}\",\n  \"message\": \"=\\\"Nieuwe CV Match! Score: \\\" + String($json.score) + \\\"% | Vacature: \\\" + $json.vacancy_title + \\\" | \\\" + $json.reasoning\"\n}",
        "options": {}
      }
    },
    {
      "id": "respond_webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2250,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, matches: $('Filter Top Matches').all().map(i => i.json) }) }}",
        "options": {}
      }
    }
  ],
