    {
      "id": "code_parse",
      "name": "Parse Vacancy JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        350
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const text = $json.content?.[0]?.text || '{}';\nlet vacancyData;\ntry {\n  vacancyData = JSON.parse(text);\n} catch (e) {\n  const match = text.match(/```(?:json)?\\n?([\\s\\S]*?)\\n?```/);\n  if (match) {\n    vacancyData = JSON.parse(match[1].trim());\n  } else {\n    throw new Error('Claude gaf geen geldig JSON terug: ' + text.substring(0, 200));\n  }\n}\nreturn [{json: vacancyData}];"
      }
    },
