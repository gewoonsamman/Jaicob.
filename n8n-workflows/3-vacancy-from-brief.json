    {
      "id": "code_prompt",
      "name": "Build Vacancy Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        350
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const brief = $('Vacancy Brief Webhook').first().json.body?.brief || $('Vacancy Brief Webhook').first().json.brief || '';\n\nconst fmt = (items) => {\n  const arr = Array.isArray(items) ? items : [];\n  return arr.slice(0, 30).map(i => `${i.id}: ${i.name}`).join(', ');\n};\n\nconst industries = fmt($('Fetch Industries').first().json);\nconst educations = fmt($('Fetch Education Levels').first().json);\nconst jobCats = fmt($('Fetch Job Categories').first().json);\nconst seniorities = fmt($('Fetch Seniorities').first().json);\n\nconst prompt = `Je bent een recruitment-specialist bij Top Match, een professioneel recruitmentbureau in Nederland. Maak van het onderstaande korte vacature-briefje een volledige, aantrekkelijke vacaturetekst.\n\n**Briefje van recruiter:**\n${brief}\n\n**Beschikbare taxonomie-opties (kies het best passende ID):**\nIndustrieën: ${industries}\nOpleidingsniveaus: ${educations}\nFunctiecategorieën: ${jobCats}\nSenioriteitsniveaus: ${seniorities}\n\nGeef je antwoord als JSON met exact deze velden:\n{\n  \"title\": \"functietitel\",\n  \"description\": \"volledige vacaturetekst in HTML-formaat met <h3>, <ul>, <li>, <p> tags\",\n  \"employmentType\": \"permanent|temporary|fixed_term|fixed_term_with_option_for_permanent|freelance|traineeship|internship\",\n  \"yearsOfExperience\": 0,\n  \"workingHours\": {\"from\": 32, \"to\": 40},\n  \"salary\": {\"period\": \"monthly\", \"from\": 0, \"to\": 0, \"currency\": \"EUR\"},\n  \"location\": {\"city\": \"stad\", \"country\": \"NL\", \"allowsRemoteWork\": false},\n  \"tags\": [\"tag1\", \"tag2\"],\n  \"industryId\": \"gekozen-id\",\n  \"educationLevelId\": \"gekozen-id\",\n  \"jobCategoryId\": \"gekozen-id\",\n  \"seniorityId\": \"gekozen-id\"\n}\n\nSchrijf de beschrijving in professioneel, enthousiast Nederlands. Antwoord ALLEEN met geldige JSON.`;\n\nreturn [{json: {prompt, brief}}];"
      }
    },
